# Database Configuration
# For Render: Use the MySQL database addon which provides these automatically
# For local development: Get these values from your Aiven MySQL database dashboard

MYSQLHOST=your-aiven-db-host.aivencloud.com
MYSQLUSER=avnadmin
MYSQLPASSWORD=your-secure-password-here
MYSQLDATABASE=student_management
MYSQLPORT=3306

# Server Configuration
PORT=3000
NODE_ENV=development

# IMPORTANT SECURITY NOTES:
# 1. NEVER commit actual credentials to GitHub
# 2. Always use this .env.example as a template only
# 3. For production on Render: Set environment variables in Render dashboard
# 4. The .env file should be listed in .gitignore
