# Database Configuration
# Get these values from your Aiven MySQL database dashboard

DB_HOST=your-aiven-db-host.a.aivencloud.com
DB_USER=avnadmin
DB_PASSWORD=your-secure-password
DB_NAME=student_management

# Server Configuration
PORT=3000
NODE_ENV=development

# Note: Never commit the actual .env file to GitHub
# Always use .env.example as a template
# Environment variables for production should be set in Render dashboard
